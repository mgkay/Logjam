<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-made OpenStreetMap extract for the offline osm_roads tests (K2a). Not real map data: twelve nodes
     and nine ways near Raleigh, each way chosen to exercise one rule (maxspeed, access hierarchy, an
     unknown highway class). Format: what Overpass returns, read by LightOSM.graph_from_file. -->
<osm version="0.6" generator="logjam-test-fixture">
  <node id="1" lat="35.780" lon="-78.640"/>
  <node id="2" lat="35.780" lon="-78.639"/>
